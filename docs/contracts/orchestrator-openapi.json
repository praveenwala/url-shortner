{
  "components": {
    "schemas": {
      "ApiErrorBody": {
        "description": "The stable error envelope every failure uses (contracts/orchestrator-api.md).\n\nDeclared as a response model so the generated OpenAPI *says* so. Without this the\ndocument advertises only FastAPI's 422 validation shape, and a client reading the\npublished contract would not know an `error` identifier exists to branch on.",
        "properties": {
          "error": {
            "title": "Error",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "error",
          "message"
        ],
        "title": "ApiErrorBody",
        "type": "object"
      },
      "ApprovalBody": {
        "properties": {
          "decision": {
            "title": "Decision",
            "type": "string"
          },
          "rationale": {
            "title": "Rationale",
            "type": "string"
          }
        },
        "required": [
          "decision",
          "rationale"
        ],
        "title": "ApprovalBody",
        "type": "object"
      },
      "ClarificationBody": {
        "properties": {
          "answer": {
            "title": "Answer",
            "type": "string"
          }
        },
        "required": [
          "answer"
        ],
        "title": "ClarificationBody",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "orchestrator",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "description": "Liveness. Deliberately touches nothing.\n\nThis answers \"is the process alive\", and must keep answering yes while the database is down \u2014\notherwise an orchestrator restarts a healthy process in a loop that cannot fix a dependency\noutage. Readiness is a separate question with a separate endpoint.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/ready": {
      "get": {
        "description": "Readiness. Requires the database, within a bounded timeout.\n\nReturns 503 rather than raising, so a probe reads a status code instead of a stack trace. The\nbody names *which* dependency failed and its exception type \u2014 never the DSN, which carries a\npassword, and never the driver message, which quotes the DSN.",
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Ready Ready Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "description": "a required dependency is unavailable"
          }
        },
        "summary": "Ready"
      }
    },
